{"nodes": [{"id": "claude_metodo_em", "label": "M\u00e9todo EM", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Marca = iniciais de Enzo Mangili; \u00e9 uma metodologia de acompanhamento nutricional (pr\u00e9-consulta, consulta, p\u00f3s-consulta, evolu\u00e7\u00e3o), n\u00e3o uma dieta."}, {"id": "claude_status_projeto", "label": "Status do projeto (Fases 0 a 9 conclu\u00eddas)", "file_type": "document", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_regras_inegociaveis", "label": "Regras inegoci\u00e1veis", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Onze regras que qualquer sess\u00e3o futura deve respeitar antes de escrever c\u00f3digo."}, {"id": "claude_nunca_inventar_dados", "label": "Nunca inventar dados (PENDENTE DE DEFINI\u00c7\u00c3O)", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Forma\u00e7\u00e3o, CRN, telefone, pre\u00e7os, depoimentos etc. s\u00f3 entram quando existirem em ./references ou no prompt; caso contr\u00e1rio ficam marcados como PENDENTE DE DEFINI\u00c7\u00c3O."}, {"id": "claude_prompt_sobre_pdf", "label": "Prompt tem prioridade sobre o PDF", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Em conflito expl\u00edcito (avulsa R$230, sem grupo exclusivo, trimestral 3+2, semestral 6+5, anual n\u00e3o vendido) o prompt do usu\u00e1rio vence o material de refer\u00eancia."}, {"id": "claude_service_role_server_only", "label": "Service role key nunca chega ao browser", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Uso exclusivo server-side para impedir bypass da RLS a partir do cliente."}, {"id": "claude_rls_obrigatoria", "label": "RLS obrigat\u00f3ria em tabela sens\u00edvel", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Nunca USING (true) em tabela com dado cl\u00ednico/financeiro/pessoal."}, {"id": "claude_fuso_america_sao_paulo", "label": "Fuso America/Sao_Paulo sempre", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Nunca depender do timezone da m\u00e1quina \u2014 bug de fuso pode liberar hor\u00e1rio indispon\u00edvel ou disparar lembrete errado."}, {"id": "claude_double_booking_proibido", "label": "Double booking proibido (preven\u00e7\u00e3o no banco)", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Constraint/transa\u00e7\u00e3o no banco, n\u00e3o s\u00f3 no frontend, porque check-antes-de-inserir na aplica\u00e7\u00e3o tem race condition."}, {"id": "claude_pagamento_webhook_server_side", "label": "Pagamento s\u00f3 confirmado por webhook server-side", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Resposta do frontend nunca \u00e9 fonte de verdade de pagamento."}, {"id": "claude_ia_sempre_estimativa", "label": "IA de refei\u00e7\u00e3o sempre estimativa, nunca prescreve", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Faixa de calorias/'aproximadamente'; a IA n\u00e3o altera dieta, meta, suplementa\u00e7\u00e3o ou tratamento."}, {"id": "claude_storage_privado", "label": "Fotos em storage privado + consentimento de imagem", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fotos de refei\u00e7\u00f5es/pacientes nunca em bucket p\u00fablico; antes/depois s\u00f3 publica com media_consents; bucket before-after privado mesmo publicado, entrega server-side (Fase 14)."}, {"id": "claude_dado_real_por_migration", "label": "Dado real por migration, fict\u00edcio por seed.sql", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Planos, pre\u00e7os e cat\u00e1logo de m\u00e9tricas s\u00e3o dado de produto (todo ambiente); seed.sql s\u00f3 dado inventado de desenvolvimento."}, {"id": "claude_security_definer_para_rls", "label": "Policy cross-table via fun\u00e7\u00e3o SECURITY DEFINER", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Um EXISTS direto herda a RLS da tabela referenciada e pode falhar silenciosamente para anon/outro papel (aconteceu com before_after_results na Fase 2)."}, {"id": "claude_qa_visual_screenshots", "label": "QA visual obrigat\u00f3rio com screenshots reais", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Playwright em 1440/768/390 (+375/430/1024/1280), an\u00e1lise visual de cada imagem, valida\u00e7\u00e3o final db:reset \u2192 build \u2192 E2E."}, {"id": "claude_views_sem_fk_postgrest", "label": "Views do Postgres n\u00e3o exp\u00f5em FK para o PostgREST", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "N\u00e3o usar embed a partir de view; ler e unir no src/data."}, {"id": "claude_appointment_charge_policy", "label": "APPOINTMENT_CHARGE_POLICY", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pol\u00edtica de cobran\u00e7a da consulta avulsa \u00e9 configur\u00e1vel e PENDENTE DE DEFINI\u00c7\u00c3O \u2014 nunca hardcodar valor real."}, {"id": "claude_dinheiro_em_centavos", "label": "Dinheiro sempre inteiro em centavos", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Evita erro de ponto flutuante em c\u00e1lculo financeiro."}, {"id": "claude_consulta_nunca_gera_receita", "label": "Consulta nunca gera receita autom\u00e1tica", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Consulta de plano j\u00e1 est\u00e1 coberta pelas parcelas; avulsa segue pol\u00edtica configur\u00e1vel."}, {"id": "claude_nao_avancar_fase_sem_autorizacao", "label": "N\u00e3o avan\u00e7ar de fase sem autoriza\u00e7\u00e3o expl\u00edcita", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ao final de cada fase, parar e aguardar confirma\u00e7\u00e3o do usu\u00e1rio."}], "edges": [{"source": "claude_regras_inegociaveis", "target": "claude_nunca_inventar_dados", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "CLAUDE.md", "source_location": null, "weight": 1}, {"source": "claude_regras_inegociav
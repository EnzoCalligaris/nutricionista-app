# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# local reference materials — never versioned (see docs/DECISIONS.md)
/references/

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report
/test-results
/blob-report
/playwright/.cache

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — never commit real secrets, but always keep the example template
.env
.env.local
.env.*.local
.env.development
.env.production
.env.test
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# IDE / editor
.vscode/*
!.vscode/extensions.json
.idea

# OS
Thumbs.db

# logs
*.log
logs/

# temp
*.tmp
.tmp/

# QA visual local (CLAUDE.md) — nunca versionado
screenshots/

# knowledge graph gerado localmente (/graphify) — so saida/cache, nunca versionado
graphify-out/

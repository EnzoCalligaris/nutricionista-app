# Copie este arquivo para .env.local e preencha os valores reais.
# Nunca commite .env ou .env.local — veja .gitignore.
# Ver src/lib/env.ts para a validação central dessas variáveis.

# ---------------------------------------------------------------------------
# Obrigatórias já na Fase 1
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Fase 2/3 — Supabase (banco de dados e autenticação)
# Obrigatórias para login/dashboard/portal do paciente funcionarem (Fase 3).
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. NUNCA expor ao browser, NUNCA prefixar com NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
DIRECT_URL=

# ---------------------------------------------------------------------------
# Fase 12 — E-mail (Resend + React Email)
# ---------------------------------------------------------------------------
RESEND_API_KEY=

# ---------------------------------------------------------------------------
# Fase 12 — WhatsApp (Business Platform oficial ou BSP compatível)
# ---------------------------------------------------------------------------
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# ---------------------------------------------------------------------------
# Fase 13 — Pagamentos (PaymentProvider)
# ---------------------------------------------------------------------------
PAYMENT_PROVIDER_SECRET_KEY=
PAYMENT_PROVIDER_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Fase 11 — Análise de foto de refeição (FoodAnalysisProvider)
# ---------------------------------------------------------------------------
# Fornecedor: `fake` (default — determinístico, sem rede, estimativa SIMULADA)
# até um vendor/modelo real ser definido (PENDENTE DE DEFINIÇÃO). Um valor
# sem adapter correspondente deixa a análise indisponível (nunca cai no fake
# em silêncio). Segredo só se o adapter real exigir — nunca NEXT_PUBLIC_.
FOOD_ANALYSIS_PROVIDER=fake
FOOD_ANALYSIS_MODEL=
FOOD_ANALYSIS_TIMEOUT_MS=45000
FOOD_ANALYSIS_PROVIDER_API_KEY=

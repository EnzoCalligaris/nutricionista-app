# Copie este arquivo para .env.local e preencha os valores reais.
# Nunca commite .env ou .env.local — veja .gitignore.
# Ver src/lib/env.ts para a validação central dessas variáveis.

# ---------------------------------------------------------------------------
# Obrigatórias já na Fase 1
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Fase 2/3 — Supabase (banco de dados e autenticação)
# Obrigatórias para login/dashboard/portal do paciente funcionarem (Fase 3).
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. NUNCA expor ao browser, NUNCA prefixar com NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
DIRECT_URL=

# ---------------------------------------------------------------------------
# Fase 12 — E-mail (EmailProvider: `fake` | `resend`)
# ---------------------------------------------------------------------------
# `fake` (default): determinístico, sem rede, registra a entrega simulada.
# `resend`: exige RESEND_API_KEY e EMAIL_FROM — sem eles o envio falha com
# erro de configuração (nunca cai no fake em silêncio). EMAIL_FROM em dev pode
# ser um endereço claramente fictício; em produção precisa de domínio
# verificado no Resend (PENDENTE DE DEFINIÇÃO).
EMAIL_PROVIDER=fake
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=

# ---------------------------------------------------------------------------
# Fase 12 — WhatsApp (WhatsAppProvider: `fake` | BSP oficial — PENDENTE)
# ---------------------------------------------------------------------------
# Só WhatsApp Business Platform / BSP oficial. Nunca automação de WhatsApp
# Web. O adapter real só existe quando o BSP for definido; até lá `fake`.
# WHATSAPP_TEMPLATE_MAP: JSON opcional `{"chave_interna":"nome_aprovado_no_bsp"}`.
WHATSAPP_PROVIDER=fake
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_MAP=

# ---------------------------------------------------------------------------
# Fase 12 — Jobs (scheduler) e tokens de ação por link
# ---------------------------------------------------------------------------
# CRON_SECRET: enviado pelo scheduler como `Authorization: Bearer <valor>`
# (Vercel Cron usa exatamente esta variável). Mínimo 16 caracteres. Ausente em
# produção = /api/cron/* recusa tudo. Nunca NEXT_PUBLIC_, nunca logado.
# NOTIFICATIONS_TOKEN_SECRET: pimenta do hash dos tokens de confirmação por
# link (só o hash vai ao banco). Gere ambos com `openssl rand -hex 32`.
CRON_SECRET=
NOTIFICATIONS_TOKEN_SECRET=

# ---------------------------------------------------------------------------
# Fase 13 — Pagamentos (PaymentProvider)
# ---------------------------------------------------------------------------
PAYMENT_PROVIDER_SECRET_KEY=
PAYMENT_PROVIDER_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Fase 11 — Análise de foto de refeição (FoodAnalysisProvider)
# ---------------------------------------------------------------------------
# Fornecedor: `fake` (default — determinístico, sem rede, estimativa SIMULADA)
# até um vendor/modelo real ser definido (PENDENTE DE DEFINIÇÃO). Um valor
# sem adapter correspondente deixa a análise indisponível (nunca cai no fake
# em silêncio). Segredo só se o adapter real exigir — nunca NEXT_PUBLIC_.
FOOD_ANALYSIS_PROVIDER=fake
FOOD_ANALYSIS_MODEL=
FOOD_ANALYSIS_TIMEOUT_MS=45000
FOOD_ANALYSIS_PROVIDER_API_KEY=
